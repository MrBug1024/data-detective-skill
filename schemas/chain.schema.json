{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Data lineage evidence graph",
  "description": "report.chain：原始记录、文档声明与实际查询连接的可导航图；不声明历史执行已证明。",
  "type": "object",
  "required": [
    "nodes",
    "edges",
    "confidence"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "node_type",
          "label"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_type": {
            "enum": [
              "result",
              "source",
              "rule",
              "intermediate"
            ]
          },
          "label": {
            "type": "string"
          },
          "source_file": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "sheet_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "row_num": {
            "type": [
              "integer",
              "null"
            ]
          },
          "field_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "field_values": {
            "type": "array"
          },
          "confidence": {
            "type": "null"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "from_node",
          "to_node",
          "edge_type"
        ],
        "properties": {
          "edge_id": {
            "type": "string"
          },
          "from_node": {
            "type": "string"
          },
          "to_node": {
            "type": "string"
          },
          "edge_type": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependency_type": {
            "enum": [
              "DIRECT",
              "INDIRECT"
            ]
          },
          "score": {
            "type": "null"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "null",
      "description": "逐条证据状态替代未经校准的总体正确概率。"
    }
  }
}
