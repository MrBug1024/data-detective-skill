{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent-extracted appearance observations; verify semantic support before compiling",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "evidence", "observations"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "render_mode": {"enum": ["feature_sheet", "partial_composite"], "default": "feature_sheet"},
    "revision_reason": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence": {"type": "array", "maxItems": 200, "items": {"$ref": "#/definitions/evidence"}},
    "observations": {"type": "array", "maxItems": 200, "items": {"$ref": "#/definitions/observation"}}
  },
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "kind", "source_id", "dependency_group", "statement", "contamination"],
      "properties": {
        "evidence_id": {"$ref": "#/definitions/id"},
        "kind": {"enum": ["direct_witness", "image_observation", "hearsay", "crime_scene", "prior_composite", "other"]},
        "source_id": {"$ref": "#/definitions/id"},
        "dependency_group": {"$ref": "#/definitions/id"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 20000},
        "contamination": {"enum": ["none_reported", "unknown", "possible", "known"]},
        "context": {"type": "string", "minLength": 1, "maxLength": 4000},
        "derived_from": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/id"}}
      }
    },
    "quote": {
      "type": "object", "additionalProperties": false, "required": ["evidence_id", "quote"],
      "properties": {
        "evidence_id": {"$ref": "#/definitions/id"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["feature_id", "status"],
      "properties": {
        "feature_id": {"enum": ["face_shape", "jaw", "chin", "cheekbones", "eyebrows", "eyes", "nose", "mouth", "ears", "hair", "facial_hair", "skin_tone", "visible_marks", "apparent_age", "glasses", "headwear"]},
        "status": {"enum": ["reported", "uncertain", "unknown", "not_visible"]},
        "value": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "laterality": {"enum": ["subject_left", "subject_right", "bilateral", "midline", "unspecified"]},
        "quotes": {"type": "array", "items": {"$ref": "#/definitions/quote"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["reported", "uncertain"]}}},
         "then": {"required": ["value", "quotes"], "properties": {"value": {"type": "string"}, "quotes": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"enum": ["unknown", "not_visible"]}}},
         "then": {"properties": {"value": {"type": "null"}, "quotes": {"maxItems": 0}, "laterality": {"const": "unspecified"}}}}
      ]
    }
  }
}
