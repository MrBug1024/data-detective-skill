{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compiled appearance specification, not an image or identity assessment",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "analysis_stage", "status", "render_state", "label", "features", "unresolved_conflicts", "evidence", "source_groups", "dependency_links", "grouping_basis", "clarification_questions", "render_request", "review_required", "limitations", "revision"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "analysis_stage": {"const": "portrait_specification"},
    "status": {"enum": ["insufficient_information", "clarification_required", "specification_ready"]},
    "render_state": {"const": "not_generated"},
    "label": {"type": "string", "minLength": 1},
    "features": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/definitions/feature"}},
    "unresolved_conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/feature_id"}},
    "evidence": {"type": "array", "items": {"$ref": "portrait-input.schema.json#/definitions/evidence"}},
    "source_groups": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["dependency_group", "evidence_ids", "independence"],
        "properties": {"dependency_group": {"type": "string"}, "evidence_ids": {"$ref": "#/definitions/ids"}, "independence": {"const": "not_established"}}
      }
    },
    "grouping_basis": {"type": "array", "items": {"type": "string"}},
    "dependency_links": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["derived_evidence_id", "upstream_evidence_id"],
      "properties": {"derived_evidence_id": {"type": "string"}, "upstream_evidence_id": {"type": "string"}}}},
    "clarification_questions": {
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["feature_id", "question", "evidence_ids"],
        "properties": {"feature_id": {"anyOf": [{"$ref": "#/definitions/feature_id"}, {"type": "null"}]}, "question": {"type": "string"}, "evidence_ids": {"$ref": "#/definitions/ids"}}}
    },
    "render_request": {
      "anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
        "required": ["mode", "prompt", "caption", "feature_bindings", "source_panels", "unknown_regions", "post_render_checks"],
        "properties": {
          "mode": {"enum": ["feature_sheet", "partial_composite"]},
          "prompt": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "feature_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/binding"}},
          "source_panels": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
            "required": ["source_id", "feature_bindings", "unknown_regions", "observation_contexts"],
            "properties": {"source_id": {"type": "string"}, "feature_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/binding"}},
              "unknown_regions": {"type": "array", "items": {"$ref": "#/definitions/feature_id"}},
              "observation_contexts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "context"], "properties": {"evidence_id": {"type": "string"}, "context": {"type": "string"}}}}
            }}},
          "unknown_regions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/feature_id"}},
          "post_render_checks": {"type": "array", "items": {"type": "string"}}
        }}]
    },
    "review_required": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "revision": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["previous_sha256", "changed_features", "added_evidence_ids", "removed_or_changed_claims", "reason", "limitation"],
      "properties": {"previous_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "changed_features": {"type": "array", "items": {"$ref": "#/definitions/feature_id"}}, "added_evidence_ids": {"$ref": "#/definitions/ids"}, "removed_or_changed_claims": {"type": "array", "items": {"type": "object"}}, "reason": {"type": "string"}, "limitation": {"type": "string"}}}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "specification_ready"}}}, "then": {"properties": {"render_request": {"type": "object"}, "unresolved_conflicts": {"maxItems": 0}}}, "else": {"properties": {"render_request": {"type": "null"}}}}
  ],
  "definitions": {
    "binding": {"type": "object", "additionalProperties": false, "required": ["feature_id", "value", "laterality", "evidence_ids", "source_ids"],
      "properties": {"feature_id": {"$ref": "#/definitions/feature_id"}, "value": {"type": "string"}, "laterality": {"$ref": "#/definitions/side"}, "evidence_ids": {"$ref": "#/definitions/ids"}, "source_ids": {"$ref": "#/definitions/ids"}}},
    "feature_id": {"enum": ["face_shape", "jaw", "chin", "cheekbones", "eyebrows", "eyes", "nose", "mouth", "ears", "hair", "facial_hair", "skin_tone", "visible_marks", "apparent_age", "glasses", "headwear"]},
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "side": {"enum": ["subject_left", "subject_right", "bilateral", "midline", "unspecified"]},
    "feature": {
      "type": "object", "additionalProperties": false, "required": ["feature_id", "status", "claims", "notes"],
      "properties": {
        "feature_id": {"$ref": "#/definitions/feature_id"},
        "status": {"enum": ["reported", "uncertain", "conflicting", "unknown", "not_visible", "unsupported"]},
        "claims": {"type": "array", "items": {"$ref": "#/definitions/claim"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{"if": {"properties": {"status": {"enum": ["unknown", "not_visible"]}}}, "then": {"properties": {"claims": {"maxItems": 0}}}}]
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "status", "evidence_ids", "quotes", "lineage_evidence_ids", "source_ids", "dependency_groups", "laterality", "render_eligible", "exclusion_reasons"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "status": {"enum": ["reported", "uncertain"]},
        "evidence_ids": {"$ref": "#/definitions/ids"},
        "quotes": {"type": "array", "minItems": 1, "items": {"$ref": "portrait-input.schema.json#/definitions/quote"}},
        "lineage_evidence_ids": {"$ref": "#/definitions/ids"},
        "source_ids": {"$ref": "#/definitions/ids"},
        "dependency_groups": {"$ref": "#/definitions/ids"},
        "laterality": {"$ref": "#/definitions/side"},
        "render_eligible": {"type": "boolean"},
        "exclusion_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
