{
  "rubric_version": "1.0",
  "purpose": "本地语义与来源约束评分；不是给被测模型的说明，不含必须猜中的人物或真实脸。",
  "global_checks": {
    "schema_version": "1.0",
    "analysis_stage": "portrait_specification",
    "render_state": "not_generated",
    "evidence_reference_rule": "所有claim的evidence_ids和quotes.evidence_id须来自对应公开案件；quote须为该statement的真实连续原文，不得伪造。",
    "source_rule": "source_ids指实际观察者或载体来源；同一访谈的多条记录、报道和转发不得视为多个独立外貌来源。来源可用案件给出的标识或等义明确名称，不强制字面拼写。",
    "unknown_rule": "unknown/not_visible/unsupported且没有受支持外观描述的feature，其claims必须为空；不能以默认眼鼻嘴、族群模板、犯罪类型或平均人脸补成已知特征。",
    "render_rule": "render_request只绑定受支持的reported/有明确不确定标注的uncertain特征；未描述区域留白/排线，不能用逼真程度作为准确性。冲突只能分来源变体或待澄清，不能融合成单一折中值。",
    "identity_rule": "合成画像及相容特征不能证明唯一身份、实际到场或实施犯罪；外观描述不支持心理诊断、族群/祖源或罪责结论。",
    "review_requirement": "机器字段检查只做诊断；应单独复核值的语义范围、实际来源、冲突和绘图提示是否忠于证据。不能仅凭关键词或图像看起来真实而给准确率。"
  },
